<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Location while the rider is Online. "While in use" is enough: the
         Online foreground service is started from the app while it is on
         screen, and a location-type foreground service keeps that access when
         the app is backgrounded. ACCESS_BACKGROUND_LOCATION ("Allow all the
         time") is therefore not declared - declaring it would also make
         geolocator ask for it. See docs/rider-background-mode. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <!-- Online status notification and ringing delivery-request alerts. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Optional floating rider bubble. Requested only when the rider turns
         the bubble on in Settings; never needed to receive requests. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <application
        android:label="Mangaale Express"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>

            <!-- Referral links.
                 Flutter's built-in deep linking hands the incoming URI to the
                 app's router, which resolves /r/:code below. -->
            <meta-data
                android:name="flutter_deeplinking_enabled"
                android:value="true" />

            <!-- Custom scheme: works as soon as the app is installed, with no
                 domain verification, so it is the reliable path today. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="mangaale-rider" android:host="referral" />
            </intent-filter>

            <!-- Android App Link for https://mangaale.com/r/<code>.
                 autoVerify only succeeds once
                 https://mangaale.com/.well-known/assetlinks.json lists this
                 package with the signing certificate's SHA-256 fingerprint.
                 Until that file is published, Android shows the usual
                 app-or-browser chooser instead of opening directly; nothing
                 breaks, the link simply falls back to the web page. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="mangaale.com"
                    android:pathPrefix="/r/" />
            </intent-filter>
        </activity>
        <!-- The Online foreground service (flutter_background_service).
             The plugin declares it without a type and exported; Android 14
             requires the location type for a location foreground service,
             and nothing outside this app should be able to start it. -->
        <service
            android:name="id.flutter.flutter_background_service.BackgroundService"
            android:exported="false"
            android:foregroundServiceType="location"
            tools:replace="android:exported" />
        <!-- Restarts the service if Android kills it while the rider is
             Online. Internal only. -->
        <receiver
            android:name="id.flutter.flutter_background_service.WatchdogReceiver"
            android:exported="false"
            tools:replace="android:exported" />
        <!-- Disabled: a rider chooses to go Online each shift, so the service
             must never start on boot or app update. -->
        <receiver
            android:name="id.flutter.flutter_background_service.BootReceiver"
            android:enabled="false"
            android:exported="false"
            tools:replace="android:enabled,android:exported" />

        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
